{
  "name": "@studio/desktop",
  "productName": "Nidavellir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nidavellir en application Windows : lance le hub et l'affiche dans sa propre fenêtre.",
  "author": "Nidavellir",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist.mjs"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "Nidavellir.Studio",
    "productName": "Nidavellir",
    "electronVersion": "45.1.0",
    "asar": true,
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png",
      "artifactName": "Nidavellir-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nidavellir",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
